# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
venv/
.venv/
.venv
env/
ENV/

# Node (for any tooling layered on top)
node_modules/
npm-debug.log*

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo

# Build artifacts that DO NOT belong in version control
# (Phase 1+ may generate these; tracked separately by run manifests)
data/raw/
data/runs/*/raw/
data/evidence/*.pdf

# Per-county run logs and transient artifacts
# The runs/<slug>/ folder itself IS committed (launch files, manifests, notes).
# But per-county logs are scratch and not committed.
runs/*/logs/
runs/*/tmp/
runs/*/.cache/
# Transient config-builder / generator scripts (e.g. _build_config.py,
# _gen_fingerprints.py) — scratch, regenerated per run, not committed.
runs/*/_*.py
# …but the staged pipeline driver + the dashboard renderer adapter ARE
# part of the deployment surface (the daily-refresh GitHub Actions workflow
# invokes them). Keep them committed.
!runs/duval_fl/_run_county_pipeline.py
!runs/duval_fl/_build_el_paso_data.py

# Secrets — never commit
.env
.env.*
!.env.example
secrets/
*.pem
*.key

# Coverage / test artifacts
.coverage
htmlcov/
.tox/
data/leads_synthetic.json
