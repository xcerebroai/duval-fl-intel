# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
venv/
.venv/
.venv
env/
ENV/

# Node (for any tooling layered on top)
node_modules/
npm-debug.log*

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo

# Build artifacts that DO NOT belong in version control
# (Phase 1+ may generate these; tracked separately by run manifests)
# Use data/raw/* (not data/raw/) so per-file `!` exceptions below can
# re-include specific files — directory-level exclusion in gitignore
# blocks all child !pattern overrides.
data/raw/*
data/runs/*/raw/
data/evidence/*.pdf

# Exception — the Tax Collector delinquency export is a MANUAL operator
# download (county-taxes.net is JS-rendered behind Cloudflare; the export
# endpoint isn't yet reverse-engineered for CI). Commit the gzipped CSV
# (24 MB; the raw is 140 MB) so the daily-refresh workflow has a known
# source to parse — otherwise CI would silently drop the 19,878 tax-default
# leads on the next refresh. Re-gzip and recommit whenever the operator
# downloads a fresh CSV.
!data/raw/duval_tax_collector_src.csv.gz

# Per-county run logs and transient artifacts
# The runs/<slug>/ folder itself IS committed (launch files, manifests, notes).
# But per-county logs are scratch and not committed.
runs/*/logs/
runs/*/tmp/
runs/*/.cache/
# Transient config-builder / generator scripts (e.g. _build_config.py,
# _gen_fingerprints.py) — scratch, regenerated per run, not committed.
runs/*/_*.py
# …but the staged pipeline driver + the dashboard renderer adapter ARE
# part of the deployment surface (the daily-refresh GitHub Actions workflow
# invokes them). Keep them committed.
!runs/duval_fl/_run_county_pipeline.py
!runs/duval_fl/_build_el_paso_data.py

# Secrets — never commit
.env
.env.*
!.env.example
secrets/
*.pem
*.key

# Coverage / test artifacts
.coverage
htmlcov/
.tox/
data/leads_synthetic.json

# Staged build receipts — regenerated each pipeline run, exceed GitHub's
# 100 MB per-file limit at Duval scale. The per-source _leads_base.json
# stays tracked (small + useful for audit); the merged matched_leads /
# scored_leads / evidence_ledger do not.
runs/*/build/staged/matched_leads.json
runs/*/build/staged/scored_leads.json
runs/*/build/staged/evidence_ledger.json
